 "beats": [
  {"say": "The Moon is spinning right now. So why do we only ever see one side?",
   "visual": {"type": "title", "kicker": "Space", "lines": ["One side.", "Every night.", "Forever."], "highlight": [2]}, "impact": true,
   "shots": [{"src": "commons:File:FullMoon2010.jpg", "focus": [0.5, 0.5], "move": "in", "w": 1.2},
             {"src": "pixabay:video:full moon night sky", "w": 1.0}]},
  {"say": "Most people think it doesn't rotate at all.", "visual": {"type": "none"},
   "shots": [{"src": "pixabay:video:moon telescope"}]},
  {"say": "But it does. It turns once every 27 days, exactly as long as one trip around Earth.",
   "visual": {"type": "cards", "items": [{"icon": "rotate-cw", "t": "1 spin", "s": "27.3 days"}, {"icon": "orbit", "t": "1 orbit", "s": "27.3 days"}]},
   "shots": [{"src": "pixabay:video:moon close up"}, {"src": "commons:File:The_Earth_seen_from_Apollo_17.jpg", "focus": [0.5, 0.5], "move": "out", "at": 9}]},
  {"say": "Billions of years ago, Earth's gravity pulled the Moon slightly out of shape and slowed its spin until the two matched.",
   "visual": {"type": "none"},
   "shots": [{"src": "pixabay:video:earth from space"}, {"src": "pixabay:video:moon surface", "at": 12}]},
  {"say": "Scientists call it tidal locking.", "visual": {"type": "title", "lines": ["Tidal", "locking."], "highlight": [1]},
   "shots": [{"src": "commons:File:FullMoon2010.jpg", "focus": [0.35, 0.4], "move": "in"}]},
  {"say": "And the far side isn't dark. It gets just as much sunlight. We first saw it in 1959, from a Soviet probe.",
   "visual": {"type": "none"},
   "shots": [{"src": "commons:File:Moon_Farside_LRO.jpg", "focus": [0.5, 0.5], "move": "in", "label": {"t": "The far side", "s": "NASA LRO"}},
             {"src": "commons:File:Luna_3_moon.jpg", "focus": [0.5, 0.5], "move": "in", "at": 16, "label": {"t": "Luna 3", "s": "First photo, 1959"}}]},
  {"say": "It's also drifting away from us, about four centimetres every year. Follow for more.",
   "visual": {"type": "none"},
   "shots": [{"src": "pixabay:video:moon night clouds"}]}
 ],
 "meta": {
  "title": "Why we only ever see one side of the Moon 🌕",
  "summary": "The Moon does spin, once every 27.3 days, the same time it takes to orbit Earth. That's tidal locking.",
